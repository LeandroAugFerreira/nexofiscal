# Copie para .env e configure os segredos. Nenhum usuário é criado ao iniciar a API.
DEMO_EMAIL=admin@nexofiscal.example.com
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Conta pública opcional para apresentar o projeto; somente dados fictícios.
PORTFOLIO_ENABLED=false
PORTFOLIO_EMAIL=portfolio@nexofiscal.example.com
PORTFOLIO_PASSWORD=
POSTGRES_DB=fitnota
POSTGRES_USER=fitnota
POSTGRES_PASSWORD=
# Execução local sem Docker; no Compose a URL é substituída pelo PostgreSQL.
DATABASE_URL=sqlite:///./fitnota.db
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:8080
COOKIE_SECURE=false
SESSION_HOURS=8
FRONTEND_PORT=8080
BACKEND_PORT=8010
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
AUTOMATION_TOKEN=
# Fora de Docker, configure somente se n8n estiver instalado e workflow publicado.
N8N_WEBHOOK_URL=
N8N_HEALTH_URL=
N8N_EDITOR_URL=

# Envio opcional: configure com infrastructure/configurar-gmail.ps1.
# A cópia distribuída inicia sem remetente nem autenticação SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NexoFiscal
